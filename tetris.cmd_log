ngdbuild -intstyle ise -dd _ngo -nt timestamp -uc cons_file.ucf -p xc6slx16-csg324-3 tetris.ngc tetris.ngd  
map -intstyle ise -p xc6slx16-csg324-3 -w -logic_opt off -ol high -t 1 -xt 0 -register_duplication off -r 4 -global_opt off -mt off -ir off -pr off -lc off -power off -o tetris_map.ncd tetris.ngd tetris.pcf 
par -w -intstyle ise -ol high -mt off tetris_map.ncd tetris.ncd tetris.pcf 
trce -intstyle ise -v 3 -s 3 -n 3 -fastpaths -xml tetris.twx tetris.ncd -o tetris.twr tetris.pcf -ucf cons_file.ucf 
bitgen -intstyle ise -f tetris.ut tetris.ncd 
